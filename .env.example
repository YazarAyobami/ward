# Ward — environment variables (source of truth; ARCHITECTURE.md §13 points here).
# Never commit a filled-in .env.

# --- Network & contracts ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
WARD_CONTRACT=ward.<you>.testnet
TOKEN_CONTRACT=tusdc.<you>.testnet
SPUTNIK_FACTORY=sputnik-v2.testnet          # VERIFY
GUARDIAN_DAO=                               # one shared demo DAO

# --- Accounts used by scripts (deploy/seed/demo) ---
DEPLOYER_ACCOUNT=
DEPLOYER_PRIVATE_KEY=

# --- Web (apps/web) — public ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_WARD_CONTRACT=ward.<you>.testnet
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- Optional (Could): AI receipt check + 1Click quote (apps/api) ---
API_PORT=8787
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
AI_REVIEWER_ACCOUNT=
AI_REVIEWER_PRIVATE_KEY=                    # function-call key → ward.post_ai_review only
ONECLICK_API_KEY=
